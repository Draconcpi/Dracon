{
  "name": "dracon",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "prisma generate && next dev --turbo",
    "build": "npx prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "db:push": "npx prisma db push",
    "db:seed": "npx tsx prisma/seed.ts",
    "db:studio": "npx prisma studio",
    "db:generate": "npx prisma generate",
    "db:reset": "npx prisma db push --force-reset && npx tsx prisma/seed.ts",
    "postinstall": "npx prisma generate"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "overrides": {
    "@typescript-eslint/eslint-plugin": "8.72.3-alpha.8",
    "@typescript-eslint/parser": "8.72.3-alpha.8",
    "@typescript-eslint/type-utils": "8.72.3-alpha.8",
    "@typescript-eslint/utils": "8.72.3-alpha.8",
    "postcss": "$postcss",
    "tsx": {
      "esbuild": "0.28.2"
    },
    "@typescript-eslint/typescript-estree": {
      ".": "8.72.3-alpha.8",
      "minimatch": "11.0.8"
    }
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@prisma/client": "^5.22.0",
    "@react-three/drei": "^9.117.0",
    "@react-three/fiber": "^8.17.10",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "framer-motion": "^12.6.3",
    "gsap": "^3.15.1",
    "jose": "^6.0.11",
    "lucide-react": "^1.72.0",
    "next": "15.5.28",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.7.0",
    "three": "^0.183.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/three": "^0.183.1",
    "eslint": "^8",
    "eslint-config-next": "15.5.28",
    "postcss": "^8.5.32",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.19.3",
    "typescript": "^5"
  }
}
